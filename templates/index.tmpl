<!DOCTYPE html>
<html lang="zh-CN">

  <head>
    <title>ReportD</title>
{{ template "head" . }}
  </head>

  <body class="bg-zinc-950 text-zinc-100 antialiased">
    <div class="mx-auto max-w-5xl px-5 py-10 sm:py-16">

      <header class="mb-12">
        <div class="flex items-center justify-between gap-4">
          <h1 class="text-2xl font-bold tracking-tight">ReportD</h1>
{{ template "topbar" . }}
        </div>

        <p id="stats" class="mt-4 text-xl font-bold"
           aria-label="{{if .HasSince}}自上次登录以来{{else}}全部数据{{end}}：共 {{ .Counts.Total }} 条，性能指标 {{ .Counts.Vitals }} 条，浏览器报告 {{ .Counts.Reports }} 条">
          <span {{if .HasSince}}title="上次登录：{{ .Since }}"{{end}}>{{if .HasSince}}自上次登录以来{{else}}全部数据{{end}}：</span>
          <span class="text-blue-500" title="总数">{{ .Counts.Total }}</span>
          <span class="text-zinc-600">|</span>
          <span class="text-green-500" title="性能指标（Web Vitals）">{{ .Counts.Vitals }}</span>
          <span class="text-zinc-600">|</span>
          <span class="text-red-500" title="浏览器报告（CSP 违规、崩溃等）">{{ .Counts.Reports }}</span>
        </p>
        <p class="mt-1 text-sm text-zinc-500">
          <span class="text-blue-500">总数</span> ·
          <span class="text-green-500">性能指标</span> ·
          <span class="text-red-500">浏览器报告</span>
        </p>
      </header>

      <main>
        <div class="mb-4 flex items-baseline justify-between">
          <h2 class="text-lg font-semibold">项目</h2>
          <span class="text-sm text-zinc-500">{{ len .Services }} 个</span>
        </div>

        {{if eq .Error "name"}}
        <p role="alert" class="mb-4 rounded-md bg-red-950 px-3 py-2 text-sm text-red-300 ring-1 ring-red-900">
          项目名只能包含字母、数字、“-” 和 “_”，最长 32 个字符。
        </p>
        {{else if .Error}}
        <p role="alert" class="mb-4 rounded-md bg-red-950 px-3 py-2 text-sm text-red-300 ring-1 ring-red-900">
          操作没有成功，请稍后再试。
        </p>
        {{end}}

        {{if .Services}}
        <ul id="projects" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {{range $name := .Services}}
          <li>
            <a href="/view/{{ $name }}" data-project="{{ $name }}"
               class="group block rounded-lg bg-zinc-900 p-4 ring-1 ring-zinc-800 transition hover:ring-zinc-600">
              <div class="flex items-center justify-between">
                <span class="truncate font-medium">{{ $name }}</span>
                <span aria-hidden="true" class="text-zinc-600 transition group-hover:translate-x-0.5 group-hover:text-zinc-300">&rarr;</span>
              </div>
              <div class="mt-3 flex min-h-6 flex-wrap gap-1.5" data-health></div>
            </a>
          </li>
          {{end}}
        </ul>
        {{else}}
        <p class="rounded-lg bg-zinc-900 p-6 text-sm text-zinc-400 ring-1 ring-zinc-800">
          还没有项目。{{if .CanManage}}在下面新建一个，然后按项目页里的接入方法把上报地址配到你的网站上。{{end}}
        </p>
        {{end}}

        {{if .CanManage}}
        <form method="post" action="/projects" class="mt-6 flex flex-wrap items-end gap-3">
          <label class="grow sm:max-w-xs">
            <span class="mb-1 block text-sm text-zinc-400">新建项目</span>
            <input name="name" required maxlength="32" pattern="[A-Za-z0-9_\-]+" autocomplete="off" spellcheck="false"
                   placeholder="例如 blog"
                   class="w-full rounded-md bg-zinc-900 px-3 py-2 text-sm text-zinc-100 ring-1 ring-zinc-700 placeholder:text-zinc-600 focus:ring-blue-500">
          </label>
          <button type="submit" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500">创建</button>
        </form>
        <p class="mt-2 text-xs text-zinc-500">只有已创建的项目才接收上报；名字会出现在上报地址里。</p>
        {{end}}
      </main>
    </div>

    <script>
      // 28-day averages per project, as rated chips for the three Core Web Vitals.
      try {
        const health = JSON.parse({{ .HealthJSON }});
        document.querySelectorAll('[data-project]').forEach((card) => {
          const box = card.querySelector('[data-health]');
          const metrics = (health[card.dataset.project] || []).filter((m) => ['LCP', 'INP', 'CLS'].includes(m.metric));
          if (!metrics.length) {
            box.append(el('span', { class: 'text-xs text-zinc-600' }, '暂无性能数据'));
            return;
          }
          for (const m of metrics) {
            const r = rate(m.metric, m.average);
            box.append(el('span', {
              class: 'rounded px-1.5 py-0.5 text-xs ring-1 ' + r.chip,
              title: VITALS[m.metric].label + '：' + formatVital(m.metric, m.average) + '（' + r.text + '）',
            }, m.metric + ' ' + formatVital(m.metric, m.average)));
          }
        });
      } catch (e) {
        console.error('rendering project health', e);
      }
    </script>
  </body>
</html>
