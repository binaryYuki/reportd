<!DOCTYPE html>
<html lang="zh-CN">

  <head>
    <title>{{ .Service }} · ReportD</title>
{{ template "head" . }}
  </head>

  <body class="bg-zinc-950 text-zinc-100 antialiased" data-service="{{ .Service }}">
    <div class="mx-auto max-w-5xl px-5 py-10 sm:py-16">

      <header class="mb-10 flex items-center justify-between gap-4">
        <div class="min-w-0">
          <a href="/" class="text-sm text-zinc-400 hover:text-white">&larr; 全部项目</a>
          <h1 id="name" class="mt-1 truncate text-2xl font-bold tracking-tight">{{ .Service }}</h1>
        </div>
{{ template "topbar" . }}
      </header>

      <main class="space-y-12">

        <!-- Web Vitals: one tile per metric. -->
        <section aria-labelledby="h-vitals">
          <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4">
            <h2 id="h-vitals" class="text-lg font-semibold">性能指标</h2>
            <p class="text-sm text-zinc-500">数值为近 28 天平均，曲线为近 90 天每日走势</p>
          </div>
          <div id="vitals" class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5"></div>
        </section>

        <!-- Browser reports: volume, breakdown, latest. -->
        <section aria-labelledby="h-reports">
          <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4">
            <h2 id="h-reports" class="text-lg font-semibold">浏览器报告</h2>
            <p class="text-sm text-zinc-500">近 90 天</p>
          </div>

          <div id="reports-empty" hidden class="rounded-lg bg-zinc-900 p-6 text-sm text-zinc-400 ring-1 ring-zinc-800">
            还没有收到浏览器报告。
          </div>

          <div id="reports-body" hidden class="space-y-3">
            <div class="grid gap-3 lg:grid-cols-3">
              <div class="rounded-lg bg-zinc-900 p-4 ring-1 ring-zinc-800 lg:col-span-2">
                <div class="flex items-baseline gap-2">
                  <span id="reports-total" class="text-3xl font-bold"></span>
                  <span class="text-sm text-zinc-500">条报告</span>
                </div>
                <div id="reports-bars" class="mt-4 flex h-24 items-end gap-px" role="img" aria-label="每日报告数量"></div>
                <div class="mt-1 flex justify-between text-xs text-zinc-600">
                  <span id="reports-from"></span>
                  <span>今天</span>
                </div>
              </div>

              <div class="rounded-lg bg-zinc-900 p-4 ring-1 ring-zinc-800">
                <h3 class="mb-3 text-sm font-medium text-zinc-400">按类型</h3>
                <ul id="reports-types" class="space-y-2 text-sm"></ul>
              </div>
            </div>

            <div id="directives-card" hidden class="rounded-lg bg-zinc-900 p-4 ring-1 ring-zinc-800">
              <h3 class="mb-3 text-sm font-medium text-zinc-400">最常被违反的 CSP 指令（近 30 天）</h3>
              <ul id="directives" class="space-y-2 text-sm"></ul>
            </div>

            <div class="overflow-hidden rounded-lg bg-zinc-900 ring-1 ring-zinc-800">
              <h3 class="px-4 pt-4 text-sm font-medium text-zinc-400">最近的报告</h3>
              <div class="overflow-x-auto">
                <table class="mt-2 w-full min-w-[40rem] table-fixed text-left text-sm">
                  <thead class="text-xs text-zinc-500">
                    <tr>
                      <th scope="col" class="w-36 px-4 py-2 font-normal">时间</th>
                      <th scope="col" class="w-28 px-4 py-2 font-normal">类型</th>
                      <th scope="col" class="px-4 py-2 font-normal">内容</th>
                      <th scope="col" class="px-4 py-2 font-normal">位置</th>
                    </tr>
                  </thead>
                  <tbody id="recent" class="divide-y divide-zinc-800"></tbody>
                </table>
              </div>
            </div>
          </div>
        </section>

        <!-- How to point a site at this project. -->
        <section aria-labelledby="h-setup">
          <details id="setup" class="group rounded-lg bg-zinc-900 ring-1 ring-zinc-800">
            <summary class="cursor-pointer select-none px-4 py-3 font-semibold marker:text-zinc-500">
              <span id="h-setup">接入方法</span>
            </summary>
            <div class="space-y-5 border-t border-zinc-800 px-4 py-4 text-sm text-zinc-300">
              <div>
                <p class="mb-2">性能指标：把这段脚本放进网页。</p>
                <pre id="snippet-vitals" class="overflow-x-auto rounded-md bg-zinc-950 p-3 text-xs text-zinc-300 ring-1 ring-zinc-800"></pre>
              </div>
              <div>
                <p class="mb-2">浏览器报告：在网站的响应头里加上这些（按需保留）。</p>
                <pre id="snippet-headers" class="overflow-x-auto rounded-md bg-zinc-950 p-3 text-xs text-zinc-300 ring-1 ring-zinc-800"></pre>
              </div>
              <div>
                <p class="mb-2">网络错误（NEL，仅 Chromium 系浏览器）：需要旧版的 Report-To 头。</p>
                <pre id="snippet-nel" class="overflow-x-auto rounded-md bg-zinc-950 p-3 text-xs text-zinc-300 ring-1 ring-zinc-800"></pre>
              </div>
            </div>
          </details>
        </section>

        {{if .CanManage}}
        <section aria-labelledby="h-danger" class="border-t border-zinc-800 pt-6">
          <h2 id="h-danger" class="sr-only">删除项目</h2>
          <form id="delete" method="post" action="/projects/{{ .Service }}/delete" class="flex flex-wrap items-center justify-between gap-3">
            <p class="text-sm text-zinc-500">删除项目会停止接收它的上报，并永久删除它的全部数据。</p>
            <button type="submit" class="rounded-md px-3 py-1.5 text-sm text-red-400 ring-1 ring-red-900 hover:bg-red-950">删除项目</button>
          </form>
        </section>
        {{end}}

      </main>
    </div>

    <script>
      const SERVICE = document.body.dataset.service;

      const TYPE_LABELS = {
        'csp': 'CSP 违规',
        'csp-violation': 'CSP 违规',
        'deprecation': '弃用 API',
        'intervention': '浏览器干预',
        'crash': '页面崩溃',
        'coep': 'COEP 违规',
        'coop': 'COOP 违规',
        'permissions-policy-violation': '权限策略',
        'document-policy-violation': '文档策略',
        'network-error': '网络错误',
        'expect-ct': 'Expect-CT',
      };
      const typeLabel = (t) => TYPE_LABELS[t] || t || '未知';

      async function getJSON(path) {
        const res = await fetch(path, { headers: { Accept: 'application/json' } });
        if (res.status === 401) {
          // The session ended; reloading sends the user through sign-in.
          location.reload();
          throw new Error('signed out');
        }
        if (!res.ok) throw new Error(path + ' answered ' + res.status);
        return res.json();
      }

      function failed(container, what) {
        container.replaceChildren(el('p', { class: 'col-span-full text-sm text-red-400', role: 'alert' }, what + '加载失败，请刷新重试。'));
      }

      // ---- Web Vitals ---------------------------------------------------

      // A line through the daily averages, drawn as SVG. With one point
      // there is no line to draw, so a dot stands in.
      function sparkline(points, color) {
        const NS = 'http://www.w3.org/2000/svg';
        const svg = document.createElementNS(NS, 'svg');
        svg.setAttribute('viewBox', '0 0 100 30');
        svg.setAttribute('preserveAspectRatio', 'none');
        svg.setAttribute('class', 'mt-3 h-8 w-full');
        svg.setAttribute('aria-hidden', 'true');
        if (!points.length) return svg;

        const values = points.map((p) => p.value);
        const min = Math.min(...values), max = Math.max(...values);
        const y = (v) => (max === min ? 15 : 27 - ((v - min) / (max - min)) * 24);
        const x = (i) => (points.length === 1 ? 50 : (i / (points.length - 1)) * 100);

        if (points.length === 1) {
          const dot = document.createElementNS(NS, 'circle');
          dot.setAttribute('cx', 50); dot.setAttribute('cy', 15); dot.setAttribute('r', 2);
          dot.setAttribute('fill', color);
          svg.append(dot);
          return svg;
        }
        const line = document.createElementNS(NS, 'polyline');
        line.setAttribute('points', points.map((p, i) => x(i).toFixed(2) + ',' + y(p.value).toFixed(2)).join(' '));
        line.setAttribute('fill', 'none');
        line.setAttribute('stroke', color);
        line.setAttribute('stroke-width', '1.5');
        line.setAttribute('stroke-linejoin', 'round');
        line.setAttribute('vector-effect', 'non-scaling-stroke');
        svg.append(line);
        return svg;
      }

      function renderVitals(data) {
        const box = document.getElementById('vitals');
        const averages = Object.fromEntries((data.averages || []).map((a) => [a.name, a.value]));
        const series = {};
        for (const s of data.summaries || []) {
          (series[s.name] = series[s.name] || []).push({ day: s.day, value: s.value });
        }

        box.replaceChildren(...Object.keys(VITALS).map((metric) => {
          const has = metric in averages;
          const rating = has ? rate(metric, averages[metric]) : null;
          const points = (series[metric] || []).sort((a, b) => a.day.localeCompare(b.day));

          return el('div', { class: 'rounded-lg bg-zinc-900 p-4 ring-1 ring-zinc-800' },
            el('div', { class: 'flex items-baseline justify-between gap-2' },
              el('span', { class: 'text-sm font-medium' }, metric),
              el('span', { class: 'truncate text-xs text-zinc-500' }, VITALS[metric].label)),
            el('div', { class: 'mt-2 text-2xl font-bold ' + (has ? '' : 'text-zinc-700') },
              has ? formatVital(metric, averages[metric]) : '—'),
            has
              ? el('span', { class: 'mt-1 inline-block rounded px-1.5 py-0.5 text-xs ring-1 ' + rating.chip }, rating.text)
              : el('span', { class: 'mt-1 inline-block text-xs text-zinc-600' }, '暂无数据'),
            sparkline(points, has ? rating.color : '#52525b'));
        }));
        return (data.averages || []).length > 0;
      }

      // ---- Browser reports ----------------------------------------------

      const isoDay = (d) => d.toISOString().slice(0, 10);

      // A proportional bar behind a "label ... count" row.
      function barRow(label, count, max, color) {
        return el('li', {},
          el('div', { class: 'flex items-baseline justify-between gap-3' },
            el('span', { class: 'truncate', title: label }, label),
            el('span', { class: 'shrink-0 text-zinc-400' }, count.toLocaleString('zh-CN'))),
          el('div', { class: 'mt-1 h-1 rounded bg-zinc-800' },
            el('div', { class: 'h-1 rounded ' + color, style: 'width:' + Math.max(2, (count / max) * 100).toFixed(1) + '%' })));
      }

      function describe(r) {
        const directive = r.violated_directive || r.effective_directive;
        let what = '—';
        if (directive) what = r.blocked_uri ? directive + ' 拦截了 ' + r.blocked_uri : directive;
        else if (r.message) what = r.message;
        else if (r.blocked_uri) what = r.blocked_uri;
        else if (r.status_code) what = 'HTTP ' + r.status_code;

        let where = r.document_uri || r.url || '—';
        if (r.source_file) where = r.source_file + (r.line_number ? ':' + r.line_number : '');
        return { what, where };
      }

      function renderReports(data) {
        const counts = data.counts || [];
        const total = counts.reduce((n, c) => n + c.count, 0);
        const recent = [...(data.recent_reports || []), ...(data.recent_report_to || [])]
          .sort((a, b) => b.created_at.localeCompare(a.created_at)).slice(0, 20);

        if (!total && !recent.length) {
          document.getElementById('reports-empty').hidden = false;
          return false;
        }
        document.getElementById('reports-body').hidden = false;
        document.getElementById('reports-total').textContent = total.toLocaleString('zh-CN');

        // Daily volume, with empty days kept so the time axis stays even.
        const perDay = {}, perType = {};
        for (const c of counts) {
          perDay[c.day] = (perDay[c.day] || 0) + c.count;
          perType[c.report_type] = (perType[c.report_type] || 0) + c.count;
        }
        const days = [];
        const today = new Date();
        for (let i = 89; i >= 0; i--) {
          days.push(isoDay(new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate() - i))));
        }
        const peak = Math.max(1, ...days.map((d) => perDay[d] || 0));
        document.getElementById('reports-from').textContent = days[0];
        document.getElementById('reports-bars').replaceChildren(...days.map((d) => {
          const n = perDay[d] || 0;
          return el('div', {
            class: 'flex-1 rounded-sm ' + (n ? 'bg-red-500/80 hover:bg-red-400' : 'bg-zinc-800'),
            style: 'height:' + (n ? Math.max(4, (n / peak) * 100) : 2) + '%',
            title: d + '：' + n + ' 条',
          });
        }));

        const types = Object.entries(perType).sort((a, b) => b[1] - a[1]);
        const typePeak = types.length ? types[0][1] : 1;
        document.getElementById('reports-types').replaceChildren(
          ...types.map(([t, n]) => barRow(typeLabel(t), n, typePeak, 'bg-red-500/80')));

        const directives = data.top_directives || [];
        if (directives.length) {
          document.getElementById('directives-card').hidden = false;
          document.getElementById('directives').replaceChildren(
            ...directives.map((d) => barRow(d.directive, d.count, directives[0].count, 'bg-amber-500/80')));
        }

        document.getElementById('recent').replaceChildren(...recent.map((r) => {
          const { what, where } = describe(r);
          const when = new Date(r.created_at);
          return el('tr', {},
            el('td', { class: 'whitespace-nowrap px-4 py-2 text-zinc-400', title: when.toISOString() },
              when.toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' })),
            el('td', { class: 'truncate px-4 py-2' }, typeLabel(r.report_type)),
            el('td', { class: 'truncate px-4 py-2', title: what }, what),
            el('td', { class: 'truncate px-4 py-2 text-zinc-400', title: where }, where));
        }));
        return true;
      }

      // ---- Setup snippets -----------------------------------------------

      function renderSetup() {
        const base = location.origin;
        document.getElementById('snippet-vitals').textContent =
`<script type="module">
  import { onCLS, onINP, onLCP, onFCP, onTTFB } from 'https://unpkg.com/web-vitals@5?module';

  function send(metric) {
    const body = JSON.stringify(metric);
    const url = '${base}/analytics/${SERVICE}';
    (navigator.sendBeacon && navigator.sendBeacon(url, body)) ||
      fetch(url, { body, method: 'POST', keepalive: true });
  }

  onCLS(send); onFCP(send); onINP(send); onLCP(send); onTTFB(send);
<\/script>`;

        document.getElementById('snippet-headers').textContent =
`Reporting-Endpoints: default="${base}/reporting/${SERVICE}"
Content-Security-Policy: ...; report-to default
Cross-Origin-Opener-Policy: same-origin; report-to="default"
Cross-Origin-Embedder-Policy: require-corp; report-to="default"
Permissions-Policy: camera=(), geolocation=(); report-to="default"`;

        document.getElementById('snippet-nel').textContent =
`Report-To: {"group":"default","max_age":10886400,"endpoints":[{"url":"${base}/report/${SERVICE}"}]}
NEL: {"report_to":"default","max_age":10886400,"failure_fraction":1}`;
      }

      // ---- Wire up ------------------------------------------------------

      renderSetup();

      const vitals = getJSON('/api/vitals/' + SERVICE).then(renderVitals)
        .catch((e) => { console.error(e); failed(document.getElementById('vitals'), '性能指标'); return true; });

      const reports = getJSON('/api/reports/' + SERVICE).then(renderReports)
        .catch((e) => {
          console.error(e);
          const box = document.getElementById('reports-empty');
          box.hidden = false;
          failed(box, '浏览器报告');
          return true;
        });

      // A project with no data yet most needs the setup instructions.
      Promise.all([vitals, reports]).then(([hasVitals, hasReports]) => {
        if (!hasVitals && !hasReports) document.getElementById('setup').open = true;
      });

      const del = document.getElementById('delete');
      if (del) {
        del.addEventListener('submit', (e) => {
          if (!confirm('确定删除项目“' + SERVICE + '”吗？它的全部数据会被永久删除，无法恢复。')) e.preventDefault();
        });
      }
    </script>
  </body>
</html>
