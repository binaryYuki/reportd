      {{if .User}}
      <form method="post" action="/auth/logout" class="flex items-center gap-3 text-sm text-zinc-400">
        <span class="hidden sm:inline">{{ .User }}</span>
        <button type="submit" class="rounded-md px-2 py-1 text-zinc-300 ring-1 ring-zinc-700 hover:bg-zinc-800 hover:text-white">退出</button>
      </form>
      {{end}}
