# Copy to .env (which git ignores) and fill in. Read by compose.yaml.

# Password for the bundled MySQL "reportd" user. Letters and digits only: it
# is embedded in a connection URL. Generate one with: openssl rand -hex 24
# MySQL applies it on first start only; changing it later needs a manual
# ALTER USER.
MYSQL_PASSWORD=

# GitHub OAuth app (https://github.com/settings/developers). Set its
# authorization callback URL to https://<your-domain>/auth/callback
REPORTD_GITHUB_CLIENT_ID=
REPORTD_GITHUB_CLIENT_SECRET=

# Comma-separated emails allowed to sign in. Each must be a verified email on
# the GitHub account.
REPORTD_ALLOWED_EMAILS=you@example.com

# Signs session cookies; 32+ characters. Generate with: openssl rand -hex 32
REPORTD_SESSION_SECRET=

# Optional. Oldest rows are deleted beyond this many GB of table storage.
# REPORTD_MAX_STORAGE_GB=5

# Optional. Host port for plain HTTP.
# REPORTD_PORT=8080

# Only for `docker compose --profile https`: the public domain to serve.
# REPORTD_DOMAIN=reportd.example.com
